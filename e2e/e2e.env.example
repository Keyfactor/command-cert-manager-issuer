# One file configures both `make e2e-setup` and `make e2e`. Copy this file to e2e.env (gitignored);
# it is picked up automatically, or point to another file with --env-file / E2E_ENV_FILE.

# --- Setup: credentials the issuer uses to authenticate to Keyfactor Command (OAuth client credentials).
E2E_OAUTH_TOKEN_URL="https://example.com/oauth2/token"
E2E_OAUTH_CLIENT_ID="changeme"
E2E_OAUTH_CLIENT_SECRET="changeme"

# Optional. Remove if not needed.
# E2E_OAUTH_AUDIENCE=""
# E2E_OAUTH_SCOPES=""

# Optional. Defaults shown. The test suite reads the same variables.
# E2E_NAMESPACE="command-issuer-system"
# E2E_RELEASE_NAME="command-cert-manager-issuer"
# E2E_AUTH_SECRET_NAME="auth-secret"
# E2E_CA_SECRET_NAME="ca-trust-secret"

# --- Tests: the Command instance the test Issuer talks to.
E2E_COMMAND_HOSTNAME="command.hostname.com"
E2E_CERTIFICATE_TEMPLATE="Server_tlsServerAuth-1y"
E2E_CERTIFICATE_AUTHORITY_LOGICAL_NAME="Sub-CA"

# Optional.
# E2E_COMMAND_API_PATH="KeyfactorAPI"
# E2E_CERTIFICATE_AUTHORITY_HOSTNAME=""
# E2E_ENROLLMENT_PATTERN_NAME=""
# E2E_OWNER_ROLE_NAME=""
# E2E_CERTIFICATE_COMMON_NAME="example.com"
# E2E_KUBE_CONTEXT=""        # kubeconfig context to test against (default: current context)
# E2E_KEEP_RESOURCES="true"  # leave test namespaces in place for debugging
